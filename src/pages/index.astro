---
import BaseLayout from '../layouts/BaseLayout.astro';import ArticleCard from '../components/ArticleCard.astro';import {getCollection} from 'astro:content';const posts=(await getCollection('blog',({data})=>!data.draft)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<BaseLayout title="업무도구노트" description="문서, 이메일, PDF, 스프레드시트, AI 등 직장인의 업무 생산성을 높이는 실용 가이드"><section class="hero"><div class="container"><div class="eyebrow">Work Smarter Guide</div><h1>반복 업무는 줄이고,<br/>중요한 일에 집중하세요.</h1><p>문서, 이메일, PDF, 스프레드시트, AI 등 직장인의 업무 생산성을 높이는 실용 가이드를 따라 하기 쉬운 단계와 실제 활용 예시 중심으로 정리합니다.</p></div></section><section class="section"><div class="container"><div class="eyebrow">Latest</div><h2>최근 글</h2><div class="grid">{posts.slice(0,6).map(p=><ArticleCard post={p}/>)}</div></div></section></BaseLayout>
