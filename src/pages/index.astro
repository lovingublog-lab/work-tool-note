---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import {getCollection} from 'astro:content';
const now=new Date();
const posts=(await getCollection('blog',({data})=>!data.draft&&data.pubDate<=now)).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
---
<BaseLayout title="PDF·문서·AI 업무도구 실용 가이드" description="PDF, 문서, 이메일, 스프레드시트, AI 업무도구와 파일 관리를 실제 업무에 바로 적용할 수 있게 정리하는 생산성 실용 정보 블로그입니다.">
  <section class="hero hero-compact"><div class="container">
    <h1>반복 업무는 줄이고, 중요한 일에 집중하세요.</h1>
    <p>문서, 이메일, PDF, 스프레드시트와 AI 업무도구를 실제 업무에 바로 적용할 수 있게 정리합니다.</p>
  </div></section>
  <section class="section section-latest"><div class="container">
    <div class="section-head"><div><div class="eyebrow">Latest</div><h2>최근 글</h2></div></div>
    <div class="grid">{posts.slice(0,6).map(p=><ArticleCard post={p}/>)}</div>
  </div></section>
</BaseLayout>
