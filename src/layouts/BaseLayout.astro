---
import '../styles/global.css';
const {title='업무도구노트',description='문서, 이메일, PDF, 스프레드시트, AI 등 직장인의 업무 생산성을 높이는 실용 가이드',image='',imageAlt='',article=false,publishedTime,modifiedTime,indexable=true}=Astro.props;
const base=import.meta.env.BASE_URL,siteName='업무도구노트',canonical=new URL(Astro.url.pathname,Astro.site),fullTitle=title===siteName?title:`${title} | ${siteName}`,imageUrl=image?new URL(image,Astro.site).href:undefined;
const jsonLd=article?{'@context':'https://schema.org','@type':'Article',headline:title,description,url:canonical.href,mainEntityOfPage:{'@type':'WebPage','@id':canonical.href},inLanguage:'ko-KR',datePublished:publishedTime,dateModified:modifiedTime||publishedTime,...(imageUrl?{image:[imageUrl]}:{}),author:{'@type':'Organization',name:siteName,url:new URL(base,Astro.site).href},publisher:{'@type':'Organization',name:siteName,url:new URL(base,Astro.site).href}}:{'@context':'https://schema.org','@type':'WebSite',name:siteName,url:new URL(base,Astro.site).href,description,inLanguage:'ko-KR'};
---
<!doctype html><html lang="ko"><head><meta charset="UTF-8"/><meta name="google-site-verification" content="UwDW2Cs_gSTsHocWy2BkFEteOf2IpzfUThRFz1W4uvY"/><meta name="viewport" content="width=device-width"/><title>{fullTitle}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" href={`${base}favicon.svg`}/><link rel="alternate" type="application/rss+xml" title="업무도구노트 RSS" href={`${base}rss.xml`}/><meta name="robots" content={indexable?'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1':'noindex,follow'}/><meta property="og:type" content={article?'article':'website'}/><meta property="og:title" content={fullTitle}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:site_name" content={siteName}/>{imageUrl&&<meta property="og:image" content={imageUrl}/>} {imageUrl&&<meta property="og:image:alt" content={imageAlt||title}/>}<meta name="twitter:card" content="summary_large_image"/>{imageUrl&&<meta name="twitter:image" content={imageUrl}/>}<script type="application/ld+json" set:html={JSON.stringify(jsonLd)}/>  {article && <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9371741860593701" crossorigin="anonymous"></script>}
</head><body><header><div class="container nav"><a class="brand" href={base}>업무도구노트</a><nav><a href={base}>홈</a><a href={`${base}articles/`}>전체 글</a><a href={`${base}about/`}>소개</a><a href={`${base}contact/`}>문의</a></nav></div></header><main><slot/></main><footer><div class="container foot"><strong>업무도구노트</strong><span>문서, 이메일, PDF, 스프레드시트, AI 등 직장인의 업무 생산성을 높이는 실용 가이드</span><div><a href={`${base}privacy/`}>개인정보처리방침</a> · <a href={`${base}contact/`}>문의</a> · <a href={`${base}rss.xml`}>RSS</a></div></div></footer></body></html>
