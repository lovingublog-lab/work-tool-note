---
import '../styles/global.css';
const {title='업무도구노트',description='문서, 이메일, PDF, 스프레드시트, AI 등 직장인의 업무 생산성을 높이는 실용 가이드',image='',imageAlt='',article=false,publishedTime,modifiedTime,indexable=true}=Astro.props;
const base=import.meta.env.BASE_URL;
const siteName='업무도구노트';
const canonical=new URL(Astro.url.pathname,Astro.site);
const fullTitle=title===siteName?title:`${title} | ${siteName}`;
const imageUrl=image?new URL(image,Astro.site).href:undefined;
const homeUrl=new URL(base,Astro.site).href;
const articlesUrl=new URL(`${base}articles/`,Astro.site).href;
const organization={'@type':'Organization','@id':`${homeUrl}#organization`,name:siteName,url:homeUrl};
const jsonLd=article?{'@context':'https://schema.org','@graph':[
  {'@type':'Article',headline:title,description,url:canonical.href,mainEntityOfPage:{'@type':'WebPage','@id':canonical.href},inLanguage:'ko-KR',datePublished:publishedTime,dateModified:modifiedTime||publishedTime,...(imageUrl?{image:[imageUrl]}:{}),author:{'@id':organization['@id']},publisher:{'@id':organization['@id']}},
  {'@type':'BreadcrumbList',itemListElement:[
    {'@type':'ListItem',position:1,name:siteName,item:homeUrl},
    {'@type':'ListItem',position:2,name:'전체 글',item:articlesUrl},
    {'@type':'ListItem',position:3,name:title,item:canonical.href}
  ]},
  organization
]}:{'@context':'https://schema.org','@graph':[
  {'@type':'WebSite','@id':`${homeUrl}#website`,name:siteName,url:homeUrl,description,inLanguage:'ko-KR',publisher:{'@id':organization['@id']}},
  organization
]};
---
<!doctype html><html lang="ko"><head>
<meta charset="UTF-8"/><meta name="google-site-verification" content="UwDW2Cs_gSTsHocWy2BkFEteOf2IpzfUThRFz1W4uvY"/><meta name="viewport" content="width=device-width"/>
<title>{fullTitle}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="icon" href={`${base}favicon.svg`}/><link rel="alternate" type="application/rss+xml" title="업무도구노트 RSS" href={`${base}rss.xml`}/>
<meta name="robots" content={indexable?'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1':'noindex,follow'}/>
<meta property="og:locale" content="ko_KR"/><meta property="og:type" content={article?'article':'website'}/><meta property="og:title" content={fullTitle}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:site_name" content={siteName}/>
{imageUrl&&<meta property="og:image" content={imageUrl}/>} {imageUrl&&<meta property="og:image:alt" content={imageAlt||title}/>}
{article&&publishedTime&&<meta property="article:published_time" content={publishedTime}/>} {article&&(modifiedTime||publishedTime)&&<meta property="article:modified_time" content={modifiedTime||publishedTime}/>}
<meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={fullTitle}/><meta name="twitter:description" content={description}/>{imageUrl&&<meta name="twitter:image" content={imageUrl}/>} {imageUrl&&<meta name="twitter:image:alt" content={imageAlt||title}/>}
<meta name="theme-color" content="#5557a6"/><script type="application/ld+json" set:html={JSON.stringify(jsonLd)}/>
{article&&<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9371741860593701" crossorigin="anonymous"></script>}
</head><body>
<header><div class="container nav"><a class="brand" href={base}>업무도구노트</a><nav class="desktop-nav" aria-label="주요 메뉴"><a href={base}>홈</a><a href={`${base}articles/`}>전체 글</a><a href={`${base}about/`}>소개</a><a href={`${base}contact/`}>문의</a><a href={`${base}search/`}>검색</a></nav><details class="mobile-menu"><summary>메뉴</summary><nav class="mobile-menu-panel" aria-label="모바일 메뉴"><a href={base}>홈</a><a href={`${base}articles/`}>전체 글</a><a href={`${base}search/`}>검색</a><a href={`${base}about/`}>소개</a><a href={`${base}contact/`}>문의</a></nav></details></div></header>
<main><slot/></main>
<footer><div class="container foot"><strong>업무도구노트</strong><span>문서, 이메일, PDF, 스프레드시트, AI 등 직장인의 업무 생산성을 높이는 실용 가이드</span><div><a href={`${base}privacy/`}>개인정보처리방침</a> · <a href={`${base}contact/`}>문의</a> · <a href={`${base}rss.xml`}>RSS</a></div></div></footer>
  <script is:inline>
    document.querySelectorAll('a[href]').forEach((link) => {
      try {
        const url = new URL(link.getAttribute('href'), window.location.href);
        if ((url.protocol === 'http:' || url.protocol === 'https:') && url.origin !== window.location.origin) {
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
        }
      } catch {}
    });
  </script>
</body></html>
